{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "GENERATED FILE — do not edit. Source of truth is src/state.ts; regenerate with `bun run schema`.",
  "$ref": "#/definitions/ThumbDoc",
  "definitions": {
    "ThumbDoc": {
      "type": "object",
      "properties": {
        "format": {
          "$ref": "#/definitions/FormatKey",
          "description": "Canvas size preset; pixel dimensions via canvasSize()."
        },
        "background": {
          "$ref": "#/definitions/Background"
        },
        "layers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Layer"
          },
          "description": "Painted back to front: index 0 is the bottom layer."
        }
      },
      "required": [
        "format",
        "background",
        "layers"
      ],
      "description": "A complete design document: a canvas format, a background, and a flat ordered list of layers. Array order IS paint order (index 0 is furthest back). There is no nesting — every layer carries its own absolute `x`/`y` in 1280×720 authoring space."
    },
    "FormatKey": {
      "type": "string",
      "enum": [
        "youtube",
        "shorts",
        "ig-post",
        "ig-reel",
        "linkedin"
      ]
    },
    "Background": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "gradient",
            "solid",
            "image",
            "effect",
            "transparent"
          ]
        },
        "from": {
          "type": "string",
          "description": "Gradient start colour; also the fill when mode is \"solid\"."
        },
        "to": {
          "type": "string",
          "description": "Gradient end colour."
        },
        "image": {
          "type": [
            "string",
            "null"
          ],
          "description": "Custom background image: a `data:` URL at runtime, a `blob:<id>` ref at rest."
        },
        "imageZoom": {
          "type": "number",
          "description": "Zoom % for image mode, 100–200 (default 100 = cover)."
        },
        "imageX": {
          "type": "number",
          "description": "Horizontal nudge % for image mode, -25…25 (default 0)."
        },
        "imageY": {
          "type": "number",
          "description": "Vertical nudge % for image mode, -25…25 (default 0) — e.g. to crop out a status bar."
        },
        "overlay": {
          "type": "number",
          "description": "Darkness of the scrim over the background, 0–100. Raise it to keep text readable."
        },
        "effect": {
          "$ref": "#/definitions/BgEffect",
          "description": "Present when mode is \"effect\"."
        },
        "gradeTint": {
          "type": "string",
          "description": "Colour grade tint painted ON TOP of every layer, to make the composite cohesive."
        },
        "gradeAmount": {
          "type": "number",
          "description": "Tint strength, 0–100."
        },
        "gradeBlend": {
          "type": "string",
          "enum": [
            "soft-light",
            "overlay",
            "multiply",
            "screen",
            "color"
          ]
        },
        "gradeVignette": {
          "type": "number",
          "description": "Darkened edges, 0–100."
        },
        "gradeGrain": {
          "type": "number",
          "description": "Film grain, 0–100."
        },
        "border": {
          "$ref": "#/definitions/BgBorder",
          "description": "Full-canvas frame border painted on top of every layer. Absent = off."
        }
      },
      "required": [
        "mode",
        "from",
        "to",
        "image",
        "overlay"
      ],
      "description": "The canvas backdrop: a gradient, a flat colour, an image, an animated effect, or nothing at all. `transparent` paints no backdrop, and a PNG export keeps that alpha — which is what makes a design usable as an overlay (a stream frame, a sticker, a logo lockup). It never becomes a JPEG: the size ladder in `export.ts` is skipped, since flattening would fill the alpha with black. Anything painted over the whole canvas — `overlay`, the colour grade — still lands on top and will fill it back in, deliberately."
    },
    "BgEffect": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "preset": {
              "type": "string",
              "const": "grainient"
            },
            "color1": {
              "type": "string"
            },
            "color2": {
              "type": "string"
            },
            "color3": {
              "type": "string"
            },
            "timeSpeed": {
              "type": "number"
            },
            "colorBalance": {
              "type": "number"
            },
            "warpStrength": {
              "type": "number"
            },
            "warpFrequency": {
              "type": "number"
            },
            "warpSpeed": {
              "type": "number"
            },
            "warpAmplitude": {
              "type": "number"
            },
            "blendAngle": {
              "type": "number"
            },
            "blendSoftness": {
              "type": "number"
            },
            "rotationAmount": {
              "type": "number"
            },
            "noiseScale": {
              "type": "number"
            },
            "grainAmount": {
              "type": "number"
            },
            "grainScale": {
              "type": "number"
            },
            "grainAnimated": {
              "type": "boolean"
            },
            "contrast": {
              "type": "number"
            },
            "gamma": {
              "type": "number"
            },
            "saturation": {
              "type": "number"
            },
            "centerX": {
              "type": "number"
            },
            "centerY": {
              "type": "number"
            },
            "zoom": {
              "type": "number"
            }
          },
          "required": [
            "preset",
            "color1",
            "color2",
            "color3",
            "timeSpeed",
            "colorBalance",
            "warpStrength",
            "warpFrequency",
            "warpSpeed",
            "warpAmplitude",
            "blendAngle",
            "blendSoftness",
            "rotationAmount",
            "noiseScale",
            "grainAmount",
            "grainScale",
            "grainAnimated",
            "contrast",
            "gamma",
            "saturation",
            "centerX",
            "centerY",
            "zoom"
          ]
        },
        {
          "type": "object",
          "properties": {
            "preset": {
              "type": "string",
              "const": "aurora"
            },
            "color1": {
              "type": "string"
            },
            "color2": {
              "type": "string"
            },
            "color3": {
              "type": "string"
            },
            "speed": {
              "type": "number"
            },
            "blend": {
              "type": "number"
            },
            "amplitude": {
              "type": "number"
            }
          },
          "required": [
            "preset",
            "color1",
            "color2",
            "color3",
            "speed",
            "blend",
            "amplitude"
          ]
        },
        {
          "type": "object",
          "properties": {
            "preset": {
              "type": "string",
              "const": "mesh"
            },
            "color1": {
              "type": "string"
            },
            "color2": {
              "type": "string"
            },
            "color3": {
              "type": "string"
            },
            "bgColor": {
              "type": "string"
            },
            "softness": {
              "type": "number"
            }
          },
          "required": [
            "preset",
            "color1",
            "color2",
            "color3",
            "bgColor",
            "softness"
          ]
        },
        {
          "type": "object",
          "properties": {
            "preset": {
              "type": "string",
              "const": "dots"
            },
            "dotColor": {
              "type": "string"
            },
            "bgColor": {
              "type": "string"
            },
            "size": {
              "type": "number"
            },
            "gap": {
              "type": "number"
            }
          },
          "required": [
            "preset",
            "dotColor",
            "bgColor",
            "size",
            "gap"
          ]
        }
      ],
      "description": "Animated background presets ported from React Bits. `grainient`/`aurora` are WebGL shaders (see EffectBackground.tsx); `mesh`/`dots` are pure CSS. Rendered only when Background.mode === \"effect\". Field names mirror the React Bits component props / Background Studio knobs 1:1."
    },
    "BgBorder": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "color": {
          "type": "string"
        },
        "width": {
          "type": "number",
          "description": "Stroke thickness in px."
        },
        "radius": {
          "type": "number",
          "description": "Corner roundness of the inner edge, in px."
        },
        "style": {
          "$ref": "#/definitions/BgBorderStyle"
        },
        "inset": {
          "type": "number",
          "description": "Gap between the canvas edge and the border box, in px."
        },
        "opacity": {
          "type": "number",
          "description": "Opacity, 0–100."
        }
      },
      "required": [
        "enabled",
        "color",
        "width",
        "radius",
        "style",
        "inset",
        "opacity"
      ]
    },
    "BgBorderStyle": {
      "type": "string",
      "enum": [
        "solid",
        "dashed",
        "dotted",
        "double"
      ]
    },
    "Layer": {
      "anyOf": [
        {
          "$ref": "#/definitions/TextLayer"
        },
        {
          "$ref": "#/definitions/ImageLayer"
        },
        {
          "$ref": "#/definitions/EmojiLayer"
        },
        {
          "$ref": "#/definitions/ShapeLayer"
        },
        {
          "$ref": "#/definitions/EffectLayer"
        },
        {
          "$ref": "#/definitions/DrawLayer"
        },
        {
          "$ref": "#/definitions/EmojiFxLayer"
        }
      ]
    },
    "TextLayer": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "text"
        },
        "text": {
          "type": "string",
          "description": "The copy. Multi-line via \\n."
        },
        "font": {
          "$ref": "#/definitions/FontKey"
        },
        "size": {
          "type": "number",
          "description": "Font size in px, in 1280×720 canvas space. Typical title: 90–140."
        },
        "color": {
          "type": "string",
          "description": "CSS colour, e.g. \"#ffffff\"."
        },
        "align": {
          "type": "string",
          "enum": [
            "left",
            "center",
            "right"
          ]
        },
        "lineHeight": {
          "type": "number",
          "description": "Line height multiplier, e.g. 1.02."
        },
        "opacity": {
          "type": "number",
          "description": "Opacity, 0–100."
        },
        "stroke": {
          "type": "boolean",
          "description": "Outline toggle."
        },
        "strokeWidth": {
          "type": "number",
          "description": "Outline thickness in px, 1280×720 space."
        },
        "strokeColor": {
          "type": "string"
        },
        "shadow": {
          "type": "boolean",
          "description": "Hard drop shadow."
        },
        "bg": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "color": {
              "type": "string"
            },
            "padX": {
              "type": "number"
            },
            "padY": {
              "type": "number"
            },
            "radius": {
              "type": "number"
            }
          },
          "required": [
            "enabled",
            "color",
            "padX",
            "padY",
            "radius"
          ],
          "description": "Optional background pill behind the text — turns a Text layer into a badge/pill."
        },
        "fx": {
          "$ref": "#/definitions/TextFx",
          "description": "Optional special effect; absent or kind \"none\" = plain fill."
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "description": "Shown in the layer list."
        },
        "x": {
          "type": "number",
          "description": "Left edge, in 1280×720 canvas space."
        },
        "y": {
          "type": "number",
          "description": "Top edge, in 1280×720 canvas space."
        },
        "rotation": {
          "type": "number",
          "description": "Rotation in degrees."
        },
        "visible": {
          "type": "boolean"
        },
        "groupId": {
          "type": "string",
          "description": "Shared across grouped layers; absent = ungrouped. ponytail: logical-only, no z-order reflow, no nesting."
        }
      },
      "required": [
        "align",
        "bg",
        "color",
        "font",
        "id",
        "lineHeight",
        "name",
        "opacity",
        "rotation",
        "shadow",
        "size",
        "stroke",
        "strokeColor",
        "strokeWidth",
        "text",
        "type",
        "visible",
        "x",
        "y"
      ],
      "description": "A run of text. Today's title lines, badge, and episode pill are all Text layers."
    },
    "FontKey": {
      "type": "string",
      "enum": [
        "archivo",
        "inter",
        "georgia",
        "mono",
        "bebas",
        "anton",
        "oswald",
        "leagueGothic",
        "leagueSpartan",
        "montserrat",
        "poppins",
        "robotoCondensed",
        "luckiestGuy",
        "bangers",
        "sfpro",
        "helvetica",
        "segoe",
        "crimsonPro",
        "geistMono",
        "libreBaskerville",
        "lobster",
        "spaceGrotesk",
        "anthropicSans",
        "cormorantLight",
        "cormorant",
        "cormorantItalic",
        "alexBrush"
      ]
    },
    "TextFx": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "none"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "gradient"
            },
            "colors": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "speed": {
              "type": "number"
            },
            "direction": {
              "type": "string",
              "enum": [
                "horizontal",
                "vertical",
                "diagonal"
              ]
            }
          },
          "required": [
            "kind",
            "colors",
            "speed",
            "direction"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "shiny"
            },
            "color": {
              "type": "string"
            },
            "shineColor": {
              "type": "string"
            },
            "spread": {
              "type": "number"
            },
            "speed": {
              "type": "number"
            },
            "direction": {
              "type": "string",
              "enum": [
                "left",
                "right"
              ]
            }
          },
          "required": [
            "kind",
            "color",
            "shineColor",
            "spread",
            "speed",
            "direction"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "glitch"
            },
            "speed": {
              "type": "number"
            },
            "color1": {
              "type": "string"
            },
            "color2": {
              "type": "string"
            },
            "enableShadows": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "speed",
            "color1",
            "color2",
            "enableShadows"
          ]
        }
      ],
      "description": "A pure-CSS text effect (React Bits-inspired). All variants render via background-clip or text-shadow so they're captured 1:1 by html-to-image on export. See ThumbCanvas."
    },
    "ImageLayer": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "image"
        },
        "src": {
          "type": [
            "string",
            "null"
          ],
          "description": "Image source: a `data:` URL at runtime, a `blob:<id>` ref at rest. Null while empty or when `brand` is set. Agents get a `blob:<id>` ref from the upload_image tool."
        },
        "origSrc": {
          "type": [
            "string",
            "null"
          ],
          "description": "Pre-background-removal original, for \"Restore\". Same encoding as `src`."
        },
        "brand": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "logo",
            "wordmark",
            null
          ],
          "description": "Built-in Claude SVG mark; overrides `src` when set. Needs no upload."
        },
        "brandColor": {
          "type": "string",
          "description": "Fill colour for the brand mark."
        },
        "scale": {
          "type": "number",
          "description": "Size factor; 1 = base width (see BASE_IMG_W / brand bases in ThumbCanvas)."
        },
        "opacity": {
          "type": "number",
          "description": "Opacity, 0–100."
        },
        "flip": {
          "type": "boolean",
          "description": "Mirror horizontally."
        },
        "radius": {
          "type": "number",
          "description": "Corner radius in px."
        },
        "ring": {
          "type": "boolean",
          "description": "Border around the image box."
        },
        "ringColor": {
          "type": "string",
          "description": "Border colour when `ringStyle` is \"solid\"."
        },
        "ringStyle": {
          "type": "string",
          "enum": [
            "solid",
            "gradient"
          ],
          "description": "Border fill: flat `ringColor`, or a multi-stop gradient traced around the edge. Absent reads as \"solid\"."
        },
        "ringColors": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 4,
          "maxItems": 4,
          "description": "Gradient stops, used when `ringStyle` is \"gradient\". Absent reads as the holo set."
        },
        "ringAngle": {
          "type": "number",
          "description": "Gradient angle in degrees (135 = top-left to bottom-right). Absent reads as 135."
        },
        "ringWidth": {
          "type": "number",
          "description": "Border thickness in px, 1280×720 space. Absent reads as 10."
        },
        "ringGlow": {
          "type": "number",
          "description": "Blur radius of a copy of the border painted behind the image, so the edge glows. 0 or absent = off."
        },
        "glow": {
          "type": "boolean",
          "description": "Glow tracing the cut-out alpha edge."
        },
        "glowStyle": {
          "type": "string",
          "enum": [
            "glow",
            "line",
            "gradient"
          ],
          "description": "Soft glow, solid sticker outline, or a gradient outline with a matching halo."
        },
        "glowColor": {
          "type": "string",
          "description": "Outline/glow colour for the \"glow\" and \"line\" styles."
        },
        "glowSize": {
          "type": "number",
          "description": "Blur radius (\"glow\") or outline thickness (\"line\", \"gradient\") in px."
        },
        "glowColors": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 4,
          "maxItems": 4,
          "description": "Gradient stops traced around the cut-out, used when `glowStyle` is \"gradient\". Absent reads as the holo set."
        },
        "glowAngle": {
          "type": "number",
          "description": "Gradient angle in degrees (135 = top-left to bottom-right). Absent reads as 135."
        },
        "glowHalo": {
          "type": "number",
          "description": "Blur radius of the coloured halo bleeding outside the gradient outline, in px. 0 = no halo. Absent reads as 18."
        },
        "glowHaloOpacity": {
          "type": "number",
          "description": "Halo opacity, 0–100. Absent reads as 70."
        },
        "brightness": {
          "type": "number",
          "description": "Brightness via CSS filter, in % (100 = neutral). Absent reads as 100."
        },
        "contrast": {
          "type": "number",
          "description": "Contrast via CSS filter, in % (100 = neutral). Absent reads as 100."
        },
        "saturation": {
          "type": "number",
          "description": "Saturation via CSS filter, in % (100 = neutral). Absent reads as 100."
        },
        "crop": {
          "type": "object",
          "properties": {
            "l": {
              "type": "number"
            },
            "t": {
              "type": "number"
            },
            "r": {
              "type": "number"
            },
            "b": {
              "type": "number"
            }
          },
          "required": [
            "l",
            "t",
            "r",
            "b"
          ],
          "description": "Non-destructive crop: edge insets as fractions 0–1 of the full image; absent = uncropped. `src` is never altered — this just hides parts of it."
        },
        "mask": {
          "type": "object",
          "properties": {
            "points": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "y"
                ]
              }
            }
          },
          "required": [
            "points"
          ],
          "description": "Lasso polygon in full-image fractions; absent = no lasso. `crop` holds its bbox."
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "description": "Shown in the layer list."
        },
        "x": {
          "type": "number",
          "description": "Left edge, in 1280×720 canvas space."
        },
        "y": {
          "type": "number",
          "description": "Top edge, in 1280×720 canvas space."
        },
        "rotation": {
          "type": "number",
          "description": "Rotation in degrees."
        },
        "visible": {
          "type": "boolean"
        },
        "groupId": {
          "type": "string",
          "description": "Shared across grouped layers; absent = ungrouped. ponytail: logical-only, no z-order reflow, no nesting."
        }
      },
      "required": [
        "brand",
        "brandColor",
        "flip",
        "glow",
        "glowColor",
        "glowSize",
        "glowStyle",
        "id",
        "name",
        "opacity",
        "origSrc",
        "radius",
        "ring",
        "ringColor",
        "rotation",
        "scale",
        "src",
        "type",
        "visible",
        "x",
        "y"
      ],
      "description": "An uploaded/captured photo, or a built-in Claude brand mark (logo/wordmark)."
    },
    "EmojiLayer": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "emoji"
        },
        "glyph": {
          "type": "string",
          "description": "The emoji character itself, e.g. \"🤯\"."
        },
        "size": {
          "type": "number",
          "description": "Rendered size in px, 1280×720 space."
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "description": "Shown in the layer list."
        },
        "x": {
          "type": "number",
          "description": "Left edge, in 1280×720 canvas space."
        },
        "y": {
          "type": "number",
          "description": "Top edge, in 1280×720 canvas space."
        },
        "rotation": {
          "type": "number",
          "description": "Rotation in degrees."
        },
        "visible": {
          "type": "boolean"
        },
        "groupId": {
          "type": "string",
          "description": "Shared across grouped layers; absent = ungrouped. ponytail: logical-only, no z-order reflow, no nesting."
        }
      },
      "required": [
        "glyph",
        "id",
        "name",
        "rotation",
        "size",
        "type",
