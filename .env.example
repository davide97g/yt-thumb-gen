# Environment for the Docker Compose deployment (Dokploy → Environment, or a local
# `.env` beside docker-compose.yml). Copy to `.env` and fill in. NEVER commit real secrets.

# Postgres (user/db have defaults; the password is required)
POSTGRES_USER=thumb
POSTGRES_DB=thumb
POSTGRES_PASSWORD=change-me-strong

# Public URL of the app. Must be https:// in production so the session cookie is Secure.
APP_URL=https://thumb.davideghiotto.it

# ── Clerk (authentication: Google sign-in) ───────────────────────────────────────
# There are no passwords in this app. Clerk holds the credential and this API verifies its
# sessions; enable providers (Google) on the Clerk instance, not here.
#
# The publishable key is public and baked into the frontend bundle at *build* time, which is why
# it appears twice: once as a build arg for the web image (VITE_ prefix) and once for the api,
# which passes it to the Clerk SDK alongside the secret. Changing it needs a rebuild.
CLERK_SECRET_KEY=sk_test_xxx
CLERK_PUBLISHABLE_KEY=pk_test_xxx
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# Who may hold an account. A Google button is reachable by every Google account there is, so this
# is the gate that used to be "you don't have a password". Comma-separated, case-insensitive.
# A first sign-in matches an existing row **by email** and claims it, which is how an account
# created under the old password auth keeps every project it owns — so this must contain the
# address that account was created under. Leave it empty and the fallback is the old rule: the
# first account claims the instance and every later one is refused.
ALLOWED_EMAILS=you@example.com

# Origins allowed to have minted a session token (Clerk's `azp` claim). Set it in production —
# it stops a token issued to another app on the same Clerk instance being replayed here. Leave
# it empty in development, where the Vite dev server is a different origin from APP_URL.
CLERK_AUTHORIZED_PARTIES=https://thumb.davideghiotto.it

# Document validation against the published JSON Schema (GET /api/schema).
#   warn    (default) log offending writes but store them anyway
#   enforce reject invalid documents with 422
# Run `docker compose exec api bun run scripts/validate-prod.ts` and get a clean report
# BEFORE switching to enforce — older rows can predate a now-required field.
THUMBDOC_VALIDATE=warn

# Unreferenced-blob collection. Every six hours the api looks for image bytes that no
# project or favourite points at any more (deleting a project used to leave them in R2
# forever) and, if enabled, releases them.
#   dry-run (default) log how many rows it would collect, touch nothing
#   enforce delete the ownership rows, and the R2 object once no user references it
# It only considers blobs older than 24h and finds references by scanning raw document
# JSON, so it errs towards keeping. Watch the [blob-gc:dry-run] lines first.
BLOB_GC=dry-run

# Headless renderer. docker-compose points this at the `render` service; unset it and
# GET /api/projects/:id/render.png answers 503 with an explanation, which is the right
# behaviour for a deployment that doesn't want a Chromium container.
#   RENDER_URL=http://render:3002

# Cloudflare R2 (S3-compatible object storage for image blobs)
#   R2_ENDPOINT = https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=yt-thumb-gen
